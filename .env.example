# ---------------------------------------------------------------------------
# WJOF Vorstandsportal - Umgebungsvariablen
#
# Lokal: Datei als ".env" kopieren und ausfuellen.
# Netlify: Site configuration -> Environment variables (identische Namen).
# ---------------------------------------------------------------------------

# --- E-Mail-Versand ueber das Vereins-Postfach (empfohlen) -----------------
# Kein eigener Dienst, keine Domain-Verifizierung noetig.
# Bei Gmail: Bestaetigung in zwei Schritten aktivieren und unter
# https://myaccount.google.com/apppasswords ein App-Passwort erzeugen.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="offenbachwj@gmail.com"
SMTP_PASSWORD=""
MAIL_FROM="WJ Offenbach Vorstand <offenbachwj@gmail.com>"

# --- Alternative: Resend (nur mit verifizierter eigener Domain) ------------
# Wird nur verwendet, wenn oben kein SMTP hinterlegt ist.
RESEND_API_KEY=""
RESEND_FROM="WJ Offenbach Vorstand <onboarding@resend.dev>"

# --- Push-Benachrichtigungen (Web Push / VAPID) -----------------------------
# Neu erzeugen mit:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="BARgUjgWCDkONgCMjD3qFOshYrFt_8oD61_sdcnX2ZbdwbM83uH0p_jbliHqRwXO2vY8Pd77FVOy26Ik4J3Xdy0"
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vorstand@wj-offenbach.de"

