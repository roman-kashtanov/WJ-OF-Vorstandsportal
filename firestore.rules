rules_version = '2';

// Sicherheitsregeln fuer das WJOF Vorstandsportal
//
// Zugriff hat nur, wer
//   1. angemeldet ist (E-Mail + Passwort oder Google),
//   2. eine BESTAETIGTE E-Mail-Adresse hat UND
//   3. mit dieser E-Mail-Adresse in der Sammlung "allowlist" eingetragen ist.
//
// Zu 2.: Bei E-Mail + Passwort koennte sich sonst jeder selbst ein Konto mit
// der Adresse eines Vorstandsmitglieds anlegen - ohne das Postfach zu
// besitzen. Konten aus der Einladung legt der Server bereits bestaetigt an
// (api/firebaseAuthAdmin.ts), Google-Konten sind immer bestaetigt.
//
// EINMALIGE EINRICHTUNG (Firebase Console -> Firestore Database -> Daten):
//   Sammlung "allowlist" anlegen und ein Dokument erstellen, dessen
//   Dokument-ID die eigene E-Mail-Adresse ist (klein geschrieben,
//   z. B. "vorname.name@gmail.com"), Feld: aktiv = true.
//   Alle weiteren Mitglieder pflegt danach die App selbst.

service cloud.firestore {
  match /databases/{database}/documents {

    function isBoardMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }

    match /allowlist/{email} {
      // Jeder Angemeldete darf GENAU SEINEN EIGENEN Eintrag pruefen.
      // Das Auflisten der gesamten Sammlung bleibt gesperrt, damit niemand
      // die E-Mail-Adressen des Vorstands auslesen kann.
      allow get: if request.auth != null && request.auth.token.email_verified == true;
      allow list: if isBoardMember();
      allow write: if isBoardMember();
    }

    // Alle uebrigen Daten (Beschluesse, Belege, Sitzungen, Mitglieder,
    // Push-Abos, Einstellungen) nur fuer freigegebene Vorstandsmitglieder.
    match /{document=**} {
      allow read, write: if isBoardMember();
    }
  }
}
